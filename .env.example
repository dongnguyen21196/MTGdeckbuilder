# Bắt buộc — Neon Postgres. Trên Vercel, tạo database trong Storage thì biến
# này được inject tự động; chỉ cần set thủ công khi chạy local hoặc trong
# GitHub Actions secrets cho job seed.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Cache TTL (ngày)
SCRYFALL_CACHE_TTL_DAYS=30
SCRYFALL_PRICE_TTL_DAYS=7
EDHREC_CACHE_TTL_DAYS=7

# Giữ collection của session ẩn danh bao lâu trước khi seeder dọn
SESSION_RETENTION_DAYS=30

# Số connection Postgres tối đa mỗi instance
DB_POOL_MAX=5
